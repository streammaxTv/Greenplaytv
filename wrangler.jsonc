{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greenplay-tv",
  "main": "worker.ts",
  "compatibility_date": "2025-11-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
